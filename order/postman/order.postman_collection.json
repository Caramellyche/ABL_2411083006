{
  "info": {
    "name": "Order API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8083"
    },
    {
      "key": "orderId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Create order",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"productId\": 1,\n  \"pelangganId\": 1,\n  \"tanggalTransaksi\": \"2026-09-18\",\n  \"jumlah\": 2,\n  \"total\": 50000.00\n}"
        },
        "url": "{{baseUrl}}/api/orders"
      }
    },
    {
      "name": "Get all orders",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/orders"
      }
    },
    {
      "name": "Get order by id",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/orders/{{orderId}}"
      }
    },
    {
      "name": "Update order",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"productId\": 1,\n  \"pelangganId\": 1,\n  \"tanggalTransaksi\": \"2026-09-18\",\n  \"jumlah\": 3,\n  \"total\": 75000.00\n}"
        },
        "url": "{{baseUrl}}/api/orders/{{orderId}}"
      }
    },
    {
      "name": "Delete order",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/api/orders/{{orderId}}"
      }
    }
  ]
}