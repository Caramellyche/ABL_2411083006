{
  "info": {
    "name": "Order Query API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8085"
    },
    {
      "key": "orderId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Get all orders",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/orders",
        "description": "Read all orders dari order_query (8085)."
      }
    },
    {
      "name": "Get order by id",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/orders/{{orderId}}",
        "description": "Read single order by orderId dari order_query (8085)."
      }
    }
  ]
}
