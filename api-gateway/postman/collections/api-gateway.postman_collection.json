{
  "info": {
    "name": "API Gateway",
    "description": "API Gateway on port 8080 with Auth (JWT) and routing to Microservices",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"faizul\",\n  \"password\": \"password123\",\n  \"role\": \"ADMIN\"\n}"
            },
            "url": "{{baseUrl}}/auth/register",
            "description": "Gateway -> lb://AUTH-SERVICE (port 8086)"
          }
        },
        {
          "name": "Login (Get JWT Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.token) {",
                  "    pm.collectionVariables.set('token', res.token);",
                  "    console.log('JWT Token saved to collection variable:', res.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"faizul\",\n  \"password\": \"password123\"\n}"
            },
            "url": "{{baseUrl}}/auth/login",
            "description": "Gateway -> lb://AUTH-SERVICE. Auto-saves JWT token to {{token}}"
          }
        }
      ]
    },
    {
      "name": "2. Protected Orders (CQRS + JWT)",
      "item": [
        {
          "name": "Get Orders (Query)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/orders",
            "description": "Gateway -> lb://ORDER-QUERY (port 8085). Protected by AuthenticationFilter."
          }
        },
        {
          "name": "Create Order (Command)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": 1,\n  \"pelangganId\": 1,\n  \"jumlah\": 2\n}"
            },
            "url": "{{baseUrl}}/api/orders",
            "description": "Gateway -> lb://ORDER-COMMAND (port 8083). Protected by AuthenticationFilter. Syncs to Query via RabbitMQ."
          }
        }
      ]
    },
    {
      "name": "3. Public Microservices",
      "item": [
        {
          "name": "Get Products",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/product",
            "description": "Gateway -> lb://PRODUCT (port 8081)"
          }
        },
        {
          "name": "Get Customers",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/customer",
            "description": "Gateway -> lb://CUSTOMER (port 8082)"
          }
        }
      ]
    }
  ]
}
